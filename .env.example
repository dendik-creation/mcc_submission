# Copy to .env (dev) or .env.production (Docker) and fill in real values.
# Never commit the filled-in file.

# --- App ---
NODE_ENV=development
PORT=3000
# Base URL the app is served from (used for absolute links, cookie domain decisions)
APP_URL=http://localhost:3000

# --- Database (app connects over the private Docker network; hostname is the
# compose service name, never a public host) ---
DATABASE_URL=postgres://submission_app:changeme@localhost:5432/submission
# Separate, higher-privilege credentials used only to run migrations.
MIGRATIONS_DATABASE_URL=postgres://submission_migrator:changeme@localhost:5432/submission

# --- Auth ---
# Sessions are opaque DB-backed tokens; this secret is only used to sign the
# cookie value against tampering before the DB lookup, generate with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-32-byte-random-base64

# --- Postgres container (compose reads these to init the db) ---
POSTGRES_DB=submission
POSTGRES_USER=submission_migrator
POSTGRES_PASSWORD=changeme
POSTGRES_APP_USER=submission_app
POSTGRES_APP_PASSWORD=changeme
